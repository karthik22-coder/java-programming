
import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        int age = new Scanner(System.in).nextInt();
        if(age < 12) System.out.println("Child Ticket Price");
        else if(age <= 60) System.out.println("Adult Ticket Price");
        else System.out.println("Senior Ticket Price");
    }
}
